# Chave da Gemini API (obrigatoria) — "Gemini API Key NANO BANANA"
GEMINI_API_KEY=

# Modelo padrao de imagem (Nano Banana 2, US$ 0,067/imagem 1K).
# gemini-2.5-flash-image foi desligado pelo Google em 02/10/2026 — nao usar.
IMAGE_MODEL=gemini-3.1-flash-image

# Modelo usado quando o request manda quality: "pro"
# (Nano Banana Pro, US$ 0,134/imagem 1K — artes com texto legivel/infografico)
IMAGE_MODEL_PRO=gemini-3-pro-image

# Porta local (Render define PORT sozinho)
PORT=3000
